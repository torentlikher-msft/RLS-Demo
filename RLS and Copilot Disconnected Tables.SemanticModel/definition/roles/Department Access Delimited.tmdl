role 'Department Access Delimited'
	modelPermission: read

	tablePermission Department =
			-- Role filter on 'Department'
			VAR _departmentKeys =
			    LOOKUPVALUE('User Department Access (Delimited)'[Department Keys],
			        'User Department Access (Delimited)'[User Email], USERPRINCIPALNAME())
			RETURN
			    PATHCONTAINS(_departmentKeys, 'Department'[Department Key])

	tablePermission 'User Department Access' = 'User Department Access'[User Email] = USERPRINCIPALNAME()

	tablePermission 'User Department Access (Delimited Override)' = 'User Department Access (Delimited Override)'[User Email] = USERPRINCIPALNAME()

	tablePermission 'User Department Access (Delimited)' = 'User Department Access (Delimited)'[User Email] = USERPRINCIPALNAME()

	tablePermission 'User Department Access (Override)' = 'User Department Access (Override)'[User Email] = USERPRINCIPALNAME()

	annotation PBI_Id = 9bc28e79bde942388dd077359a5f4218

