	/// Patient destination or status at encounter end: Home or Self Care (routine discharge), Skilled Nursing Facility (SNF), Home Health Service, Transferred to Acute Care, Against Medical Advice (AMA, left before discharge), or Expired (patient died).
	column 'Discharge Disposition'
		dataType: string
